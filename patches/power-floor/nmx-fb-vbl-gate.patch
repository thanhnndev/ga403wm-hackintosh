     static void vblFire(thread_call_param_t p0, thread_call_param_t) {
         NMXAMDFB *me = (NMXAMDFB *)p0;
-        if (me->fStopping) return;
+        if (me->fStopping) { me->fVblArmed = 0; return; }
+        if (me->fVblGate && (!me->fVbl.on || !me->fVbl.proc)) {
+            me->fVblArmed = 0;                    /* masked: stop; setInterruptState(on) re-arms */
