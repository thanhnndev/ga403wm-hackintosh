<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleExecutable</key><string>StrixAmp</string>
	<key>CFBundleIdentifier</key><string>com.itlmt7925.strixamp</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>StrixAmp</string>
	<key>CFBundlePackageType</key><string>KEXT</string>
	<key>CFBundleShortVersionString</key><string>0.2.0</string>
	<key>CFBundleVersion</key><string>0.2.0</string>
	<key>IOKitPersonalities</key>
	<dict>
		<key>StrixAmp</key>
		<dict>
			<key>CFBundleIdentifier</key><string>com.itlmt7925.strixamp</string>
			<key>IOClass</key><string>StrixAmp</string>
			<key>IOProviderClass</key><string>VoodooI2CDeviceNub</string>
			<!-- VoodooI2C publishes CSC3556 as the IOName *property* of the nub (registry name stays SPKR), so IONameMatch never
			     matches; VoodooI2CHID matches by property too. -->
			<key>IOPropertyMatch</key>
			<dict><key>IOName</key><string>CSC3556</string></dict>
			<key>IOProbeScore</key><integer>1000</integer>
		</dict>
	</dict>
	<key>OSBundleRequired</key><string>Root</string>
	<key>OSBundleLibraries</key>
	<dict>
		<key>com.alexandred.VoodooI2C</key><string>2.0.0</string>
		<key>com.apple.kpi.bsd</key><string>12.0</string>
		<key>com.apple.kpi.iokit</key><string>12.0</string>
		<key>com.apple.kpi.libkern</key><string>12.0</string>
		<key>com.apple.kpi.mach</key><string>12.0</string>
	</dict>
</dict>
</plist>
