 }
 
+/* NVMTL (macOS port): move a resident host-pointer BO from the global list to the surface list (surface = true) or
+ * back. Only BOs that are on the global list now (not local, not with RADV_DEBUG=allbos) move. */
+VkResult
+radv_amdgpu_nvmtl_bo_set_surface(struct radeon_winsys *_ws, struct radeon_winsys_bo *_bo, bool surface)
+{
+   struct radv_amdgpu_winsys *ws = radv_amdgpu_winsys(_ws);
+   struct radv_amdgpu_winsys_bo *bo = radv_amdgpu_winsys_bo(_bo);
+
+   if (!bo || bo->base.is_local || bo->base.is_virtual || ws->debug_all_bos)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   if (bo->nvmtl_surface == surface)
+      return VK_SUCCESS;
+
+   u_rwlock_wrlock(&ws->global_bo_list.lock);
+   bool found = false;
+   if (surface) {
+      for (unsigned i = ws->global_bo_list.count; i-- > 0;) {
+         if (ws->global_bo_list.bos[i] == bo) {
+            ws->global_bo_list.bos[i] = ws->global_bo_list.bos[ws->global_bo_list.count - 1];
+            --ws->global_bo_list.count;
+            found = true;
+            break;
+         }
+      }
+      if (found && ws->surface_bo_list.count == ws->surface_bo_list.capacity) {
+         unsigned capacity = MAX2(64, ws->surface_bo_list.capacity * 2);
+         void *data = realloc(ws->surface_bo_list.bos, capacity * sizeof(struct radv_amdgpu_winsys_bo *));
+         if (!data) {
+            ws->global_bo_list.bos[ws->global_bo_list.count++] = bo; /* the slot it left is still there */
+            u_rwlock_wrunlock(&ws->global_bo_list.lock);
+            return VK_ERROR_OUT_OF_HOST_MEMORY;
+         }
+         ws->surface_bo_list.bos = (struct radv_amdgpu_winsys_bo **)data;
+         ws->surface_bo_list.capacity = capacity;
+      }
+      if (found) {
+         ws->surface_bo_list.bos[ws->surface_bo_list.count++] = bo;
+         bo->nvmtl_surface = true;
+         bo->base.use_global_list = false; /* radv_cs_add_buffer adds it to the command streams that use it */
+      }
+      u_rwlock_wrunlock(&ws->global_bo_list.lock);
+      return found ? VK_SUCCESS : VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+
+   for (unsigned i = ws->surface_bo_list.count; i-- > 0;) {
+      if (ws->surface_bo_list.bos[i] == bo) {
+         ws->surface_bo_list.bos[i] = ws->surface_bo_list.bos[ws->surface_bo_list.count - 1];
+         --ws->surface_bo_list.count;
+         found = true;
+         break;
+      }
+   }
+   bo->nvmtl_surface = false;
+   u_rwlock_wrunlock(&ws->global_bo_list.lock);
+   return found ? radv_amdgpu_global_bo_list_add(ws, bo) : VK_ERROR_FEATURE_NOT_PRESENT;
+}
