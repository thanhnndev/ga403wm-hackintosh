+void
+radv_amdgpu_nvmtl_cs_set_exact(struct ac_cmdbuf *_cs)
+{
+   radv_amdgpu_cs(_cs)->nvmtl_exact = true;
+}
+
+/* NVMTL: a submit carries the surface list unless every command stream in it listed its own surfaces */
+static bool
+radv_amdgpu_nvmtl_needs_surfaces(struct radv_amdgpu_winsys *ws, struct ac_cmdbuf **cs_array, unsigned count)
+{
+   if (!ws->surface_bo_list.count)
+      return false;
+   for (unsigned i = 0; i < count; ++i) {
+      for (struct radv_amdgpu_cs *cs = radv_amdgpu_cs(cs_array[i]); cs; cs = cs->chained_to) {
+         if (!cs->nvmtl_exact)
+            return true;
+      }
+   }
+   return false;
+}
+
+static unsigned
+radv_amdgpu_copy_nvmtl_surfaces(struct radv_amdgpu_winsys *ws, struct drm_amdgpu_bo_list_entry *handles, unsigned n)
+{
+   for (uint32_t i = 0; i < ws->surface_bo_list.count; i++) {
+      handles[n].bo_handle = ws->surface_bo_list.bos[i]->bo_handle;
+      handles[n].bo_priority = ws->surface_bo_list.bos[i]->priority;
+      n++;
+   }
+   return n;
+}
+
