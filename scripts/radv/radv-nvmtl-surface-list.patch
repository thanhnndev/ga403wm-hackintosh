index 0000000..f89ea32
--- /dev/null
+++ b/src/amd/vulkan/radv_nvmtl.c
@@ -0,0 +1,63 @@
+/*
+ * Copyright 2026 thanhnndev and contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Private entry points for NVMTL, the Metal driver of the macOS port (found with dlsym, not part of Vulkan).
+ *
+ * NVMTL imports every IOSurface it wraps as host memory. Host-pointer imports are not local BOs, so RADV keeps them
+ * on the global BO list and every submit hands all of them to the kernel, used or not: with WindowServer's hundreds
+ * of surfaces the CS ioctl spends ~1 ms per submit locking and validating BOs it does not touch.
+ *
+ *   radv_nvmtl_memory_set_surface(dev, mem, true)   move an imported allocation to the surface list
+ *   radv_nvmtl_cmd_use_memory(cb, mem)              this command buffer uses that allocation
+ *   radv_nvmtl_cmd_exact(cb)                         this command buffer listed every surface it uses
+ *
+ * A submit carries the whole surface list unless every command buffer in it is exact, so a client that never calls
+ * these gets the old behaviour.
+ */
+#include "radv_cmd_buffer.h"
+#include "radv_device.h"
+#include "radv_device_memory.h"
+#include "radv_radeon_winsys.h"
+#include "winsys/amdgpu/radv_amdgpu_bo.h"
+#include "winsys/amdgpu/radv_amdgpu_cs.h"
+
+PUBLIC uint32_t radv_nvmtl_abi(void);
+PUBLIC VkResult radv_nvmtl_memory_set_surface(VkDevice device, VkDeviceMemory memory, VkBool32 surface);
+PUBLIC void radv_nvmtl_cmd_use_memory(VkCommandBuffer commandBuffer, VkDeviceMemory memory);
+PUBLIC void radv_nvmtl_cmd_exact(VkCommandBuffer commandBuffer);
+
+PUBLIC uint32_t
+radv_nvmtl_abi(void)
+{
+   return 1;
+}
+
+PUBLIC VkResult
+radv_nvmtl_memory_set_surface(VkDevice _device, VkDeviceMemory _mem, VkBool32 surface)
+{
+   VK_FROM_HANDLE(radv_device, device, _device);
+   VK_FROM_HANDLE(radv_device_memory, mem, _mem);
+   if (!device || !mem || !mem->bo)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   return radv_amdgpu_nvmtl_bo_set_surface(device->ws, mem->bo, surface);
+}
+
+PUBLIC void
+radv_nvmtl_cmd_use_memory(VkCommandBuffer commandBuffer, VkDeviceMemory _mem)
+{
+   VK_FROM_HANDLE(radv_cmd_buffer, cmd_buffer, commandBuffer);
+   VK_FROM_HANDLE(radv_device_memory, mem, _mem);
+   if (!cmd_buffer || !mem || !mem->bo)
+      return;
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   radv_cs_add_buffer(device->ws, cmd_buffer->cs->b, mem->bo);
+}
+
+PUBLIC void
+radv_nvmtl_cmd_exact(VkCommandBuffer commandBuffer)
+{
+   VK_FROM_HANDLE(radv_cmd_buffer, cmd_buffer, commandBuffer);
+   if (cmd_buffer && cmd_buffer->cs)
+      radv_amdgpu_nvmtl_cs_set_exact(cmd_buffer->cs->b);
+}
