 }
 
+#if DETECT_OS_APPLE
+/* macOS: WindowServer runs with effective uid/gid _windowserver (88) and real uid/gid root (0), so __normal_user() is
+ * false and the cache was always off there: every login recompiled all of WindowServer's pipelines (~64 s of CPU).
+ * The check exists so a setuid/setgid program never writes into the real user's cache. Allow the cache when the
+ * process names its cache explicitly with MESA_SHADER_CACHE_DIR and that directory already exists, is owned by the
+ * effective uid and is writable by nobody else: the cache then belongs to the effective user only. */
+static bool
+disk_cache_euid_dir_ok(void)
+{
+   const char *dir = getenv("MESA_SHADER_CACHE_DIR");
+   struct stat st;
+   if (!dir || dir[0] != '/' || lstat(dir, &st) != 0)
+      return false;
+   return S_ISDIR(st.st_mode) && st.st_uid == geteuid() && !(st.st_mode & (S_IWGRP | S_IWOTH));
+}
+#endif
+
 bool
 disk_cache_enabled()
 {
    /* If running as a users other than the real user disable cache */
+#if DETECT_OS_APPLE
+   if (!__normal_user() && !disk_cache_euid_dir_ok())
+      return false;
+#else
    if (!__normal_user())
       return false;
+#endif
 
