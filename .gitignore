# build output and local working material
build/
dist/
out/
ref/
*.kext
__pycache__/
# never commit these: real EFI binaries, backups, logs
efi/**/Kexts/
efi/**/Drivers/
efi/**/Resources/
*.efi
config.plist.bak*
config.*.plist
!efi/OC/config.plist
ITLLOG.BIN
nv*.txt

# local captures: they hold serial numbers, UUIDs, MAC addresses, SSIDs or process lists. out/ and ref/ are ignored
# above; out/pre-upgrade-24H32/ is the one sanitized snapshot that is tracked on purpose (it was force-added).
.DS_Store
captures/
logs/
ioreg-*.txt
ioreg*.plist
*.ioreg
*.panic
*.shutdownStall
*.spindump.txt
tools/sim-bench/*.txt
tools/sim-bench/flutter/out-*.txt

# local tool binaries (fetched by tools/get-ipsw.sh)
tools/bin/
scripts/nmx-cstrace/cave.o
tools/890m/vcndec/clips/*.ivf
tools/890m/inuse-test/inuse_test

# video suite: clips are generated on the machine (default cache ~/Library/Caches/ga403wm-video-suite)
tools/890m/video-suite/clips/
tools/890m/video-suite/results/**/.prime/
*.webm.part
